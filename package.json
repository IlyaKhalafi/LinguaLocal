{
  "name": "lingualocal",
  "version": "2.0.0",
  "private": true,
  "description": "A local learning hub for language schools",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "content:validate": "tsx scripts/validate-content.ts",
    "content:export": "tsx scripts/export-content.ts",
    "content:gallery": "tsx scripts/create-pack-gallery.ts",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts",
    "readme:preview": "tsx scripts/readme-preview.ts",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:diagnose": "tsx scripts/diagnose-content.ts",
    "vocabulary:import": "tsx scripts/import-vocabulary.ts",
    "vocabulary:export": "tsx scripts/export-vocabulary.ts",
    "worksheets:create": "tsx scripts/create-worksheets.ts",
    "test:tools": "node scripts/check-tools.mjs",
    "release:package": "node scripts/package-release.mjs",
    "subtitles:check": "tsx scripts/subtitles.ts check",
    "subtitles:convert": "tsx scripts/subtitles.ts convert",
    "content:snapshot": "tsx scripts/server-snapshot.ts create",
    "content:restore": "tsx scripts/server-snapshot.ts restore"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "csv-parse": "7.0.3",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
